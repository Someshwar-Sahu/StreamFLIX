{
  "name": "desktop",
  "version": "0.1.0",
  "description": "StreamFlix desktop app — Electron wrapper for the StreamFlix web client",
  "author": "Someshwar",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node build-web.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.streamflix.desktop",
    "productName": "StreamFlix",
    "files": ["main.js", "web-build/**/*"],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3"
  }
}