# =====================================================================
# StreamFlix Master Workspace Environment Configuration (.env.example)
# =====================================================================
# Copy this file to '.env' in the workspace root directory.
# Both Backend, Web, Mobile, and Desktop apps read from this single file.

# ---------------------------------------------------------------------
# 1. API Backend Server Endpoints (Web, Mobile, Desktop)
# ---------------------------------------------------------------------
# For Local Development:
VITE_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# For Production Deployments (Render Live Server Example):
# VITE_API_BASE_URL=https://streamflix-api.onrender.com
# EXPO_PUBLIC_API_BASE_URL=https://streamflix-api.onrender.com
# API_BASE_URL=https://streamflix-api.onrender.com

# ---------------------------------------------------------------------
# 2. Database Connection (Supabase PostgreSQL / Local Postgres)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# 3. Redis Cache & Celery Task Queue
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# 4. Security & JWT Token Authentication
# ---------------------------------------------------------------------
JWT_SECRET=your_super_secret_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---------------------------------------------------------------------
# 5. CORS Allowed Origins
# ---------------------------------------------------------------------
CORS_ORIGINS=*

# ---------------------------------------------------------------------
# 6. Optional Email / SMTP Verification Config
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_NAME="StreamFlix Verification"

# ---------------------------------------------------------------------
# 7. Cloudflare CDN & Object Storage Accounts (Optional)
# ---------------------------------------------------------------------
CLOUDFLARE_CDN_URL=https://streamflix-cdn.yourdomain.workers.dev

B2_ACC1_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_ACC1_ACCESS_KEY=your_b2_acc1_access_key
B2_ACC1_SECRET_KEY=your_b2_acc1_secret_key
B2_ACC1_BUCKET=streamflix-b2-1
B2_ACC1_MAX_GB=9.5
